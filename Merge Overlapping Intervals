function merge(intervals) {
  if (intervals.length <= 1) return intervals;

  // Step 1: Sort intervals by their start time
  intervals.sort((a, b) => a[0] - b[0]);

  const result = [intervals[0]];

  // Step 2: Iterate through and merge if needed
  for (let i = 1; i < intervals.length; i++) {
    const last = result[result.length - 1];  // Last interval in result
    const current = intervals[i];           // Current interval to compare

    if (current[0] <= last[1]) {
      // Overlapping → update the end of the last interval
      last[1] = Math.max(last[1], current[1]);
    } else {
      // No overlap → push new interval to result
      result.push(current);
    }
  }

  return result;
}

