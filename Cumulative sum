//Given an array of integers, return a new array where each element at index i is the sum of elements from index 0 to i in the original array.

var arr = [1,2,3,4,5,6];
var result = [arr[0]];
console.log(result)
var temp = arr[0]
for(var i=1; i<arr.length; i++){
  temp = temp+arr[i];
  result.push(temp)
}

console.log(result);
