//Pascal's triangle

function triangle(num){
    var result = [];

function pascal(num){
    if(num==1) return [1];
    var previous = pascal(num-1);
    var current = [1];
    for(var i=1; i<num-1; i++){
        current.push(previous[i-1]+previous[i])
    }
    current.push(1);
    return current
}

for(var i=1; i<=num; i++){
    result.push(pascal(i))
}

return result;
}

console.log(triangle(10))
