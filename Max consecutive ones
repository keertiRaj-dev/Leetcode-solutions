//Given an array of integers, find the maximum number of consecutive 1s.

var arr = [1, 1,1,1,1, 3, 2, 3, 1, 1, 1,1];

function max(arr) {
    let max = 0;
    let current = 0;

    for (let i = 0; i < arr.length; i++) {
        if (arr[i] == 1) {
            current++;
            if (current > max) max = current;
        } else {
            current = 0;
        }
    }

    return max;
}

