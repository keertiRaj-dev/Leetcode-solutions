//anagram check

var str1 = 'eefarth';
var str2 = 'heeeart';

//normal solution
function anagram(str1, str2){
    var set1 = {};
var set2 = {};
if(str1.length != str2.length){
    return "no"
}
else{
    for(var i=0; i<str1.length; i++){
        if(!set1[str1[i]]){
            set1[str1[i]]=1;
        }
        else if(set1[str1[i]]){
            set1[str1[i]]++
        }
        if(!set2[str2[i]]){
               set2[str2[i]]=1;
        }
          else if(set2[str2[i]]){
            set2[str2[i]]++
        }
    }
   var keys1 = Object.keys(set1);
   for(var j=0; j<keys1.length; j++){
       if(set1[keys1[j]]!=set2[keys1[j]]){
           return "no"
       }
   }
   return "yes"
}
}

console.log(anagram(str1, str2))

//optimised solution

function anagram2(str1, str2) {
    if (str1.length !== str2.length) return "not anagram";
    if (str1.length === 0) return "empty strings";

    const freq = {};

    for (let i = 0; i < str1.length; i++) {
        freq[str1[i]] = (freq[str1[i]] || 0) + 1;
        freq[str2[i]] = (freq[str2[i]] || 0) - 1;
    }

    for (let key in freq) {
        if (freq[key] !== 0) return "not anagram";
    }

    return "anagram";
}

console.log(anagram2(str1, str2))

 
