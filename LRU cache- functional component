//LRU Cache

function createCache(capacity){
    let cache = new Map();
    
    function get(key){
        if(!cache.has(key))
        return -1;
        
        const value = cache.get(key);
        cache.delete(key);
        cache.set(key, value);
        return value;
    }
    
    function put(key, value){
        if(cache.has(key)){
        cache.delete(key);
        }
        cache.set(key, value);
        if(cache.size>capacity){
            const firstKey = cache.keys().next().value;
            cache.delete(firstKey)
            }
    }
    
    function print(){
        console.log(cache);
    }
    
    return {get, put, print}
}

