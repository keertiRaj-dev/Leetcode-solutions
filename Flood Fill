//Flood fill
var array = [[1,0,0],
             [0,0,0],
             [1,1,1]];
var index = [1,1];
var num = 2;
var length = [2,2]

function flood(array, index, num, length){
    var left = index[0];
    var right = index[1]
    var value = array[left][right];
    var directions = [[-1,0],[0,1],[1,0],[0,-1]];
    function fill(left, right){
      if(left<0 || right<0 || left>=array.length || right>=array.length){
            return;
        }
        if(array[left][right]!=value){
            return;
        }
        array[left][right]=num;
    for(var i=0; i<directions.length; i++){
            var leftDiff = directions[i][0];
            var rightDiff = directions[i][1];
            fill(left+leftDiff, right+rightDiff )
    }
    }
    fill(left,right)
    return array;
}

console.log(flood(array, index, num, length))


//optimised solution

const image =[[1,1,1],[1,1,0],[1,0,1]];
const target = [1, 1];
const color = 2;
const length = [2,2]
function flood(image, target, color){
    const row = target[0];
    const col = target[1];
    const originalColor = image[row][col];
    if(originalColor == color) {
        return image;
    }
    
    function fill(r, c){
        if(r<0 || r>length[0] || c<0 || c>length[1] || originalColor!=image[r][c]){
            return;
        }
        image[r][c]=color;
        fill(r-1, c);
        fill(r+1, c);
        fill(r, c-1);
        fill(r, c+1)
    }
    fill(row, col);
    return image;
};

console.log(flood(image, target, color))


