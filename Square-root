//Given a non-negative integer 'n', compute and return the square root of 'n'. If n is not a perfect square, return the floor of the result.


//solution 1
function root(n) {
  if (n === 0 || n === 1) return n;

  let i = 1;
  while (i * i <= n) {
    i++;
  }
  return i - 1;
}

