/* Given n pairs of parentheses, write a function to generate all combinations of well-formed (i.e., valid) parentheses.
Input: n = 3
Output: ["((()))","(()())","(())()","()(())","()()()"]
*/
function  generateParenthesis(n){
    var result = [];
    var queue = [{str: '', open: 0, close: 0}]
    
    while(queue.length){
        var {str, open, close} = queue.shift();
        
        if(str.length==n*2){
            result.push(str)
        }
        if(open<n){
            queue.push({str: str+"(", open: open+1, close: close})
        }
        if(close<open){
            queue.push({str: str+')', open:open, close:close+1})
        }
    }
    return result
}
console.log(generateParenthesis(3))
