//Merge two sorted arrays
var arr1= [1, 2, 3, 4, 4];
var arr2= [2, 4, 5, 5];

function merge(arr1, arr2){
    var result = [];
  while(arr1.length && arr2.length)
    if(arr1[0]>arr2[0]){
        result.push(arr2[0]);
        arr2.shift()
    }
    else{
         result.push(arr1[0]);
        arr1.shift()
    }
    
    
    return [...result, ...arr1, ...arr2]
}

//other similar way
//merge two sorted arrays

var arr1 = [3,4,4,6,8,10,34];
var arr2 = [1,2,5,6,7,9,11,55];

function merge(arr1, arr2){
    var i=0;
    var j=0;
    var result = [];
    while(i<arr1.length && j<arr2.length){
        if(arr1[i]<arr2[j]){
            result.push(arr1[i]);
            i++;
        }
        else if(arr1[i]>arr2[j]){
            result.push(arr2[j]);
            j++;
        }
        else if(arr1[i]==arr2[j]){
            result.push(arr1[i]);
            i++;
            result.push(arr2[j]);
            j++;
        }
    }
     while (i < arr1.length) {
        result.push(arr1[i]);
        i++;
    }
    while (j < arr2.length) {
        result.push(arr2[j]);
        j++;
    }
    return result;
}
