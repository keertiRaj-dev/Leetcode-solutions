//Given a number n, return "yes" if it's a perfect square by checking all integers from 1 to n. Otherwise, return "no".

//my solution 
var num = 9;
function square(num){
  for(var i=1; i<=num; i++){
      if(num/i == i){
          return "true"
      }
  }
    return "false"
}
console.log(square(num));

//more optimized solution
function square(num) {
  for (let i = 1; i * i <= num; i++) {
    if (i * i === num) return "true";
  }
  return "false";
}

